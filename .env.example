# Copie ce fichier vers `.env` puis renseigne les valeurs.
#   cp .env.example .env
# Next.js charge `.env` automatiquement au démarrage (`npm run dev` / `build`).

# Obligatoire — l'app lève une erreur sans cette variable (src/db/index.ts).
# Exemple pour un Postgres local par défaut (voir drizzle.config.json) :
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Facultatif — utilisé uniquement par scripts/sync-creator-avatars.mjs pour
# résoudre les avatars via l'API Helix officielle. Sans ces deux valeurs, le
# script retombe sur decapi.me / unavatar.io.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
