{
  "name": "creatordeck",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cloud-guard.mjs && next build && node scripts/prune-prototypes.mjs",
    "start": "serve out",
    "lint": "eslint .",
    "e2e": "playwright test",
    "quality:mobile": "node scripts/mobile-quality.mjs",
    "quality:mobile:full": "node scripts/mobile-quality.mjs --full",
    "quality:android": "node scripts/android-emulator-smoke.mjs",
    "test:autonomy": "node --test scripts/apk-release-gate.test.mjs scripts/android-emulator-smoke.test.mjs scripts/ci-incident-report.test.mjs scripts/delegate-claude.test.mjs scripts/mobile-quality.test.mjs scripts/quality-incidents.test.mjs",
    "sfx:niveaux": "node scripts/sfx-niveaux.mjs",
    "streamer:bilan": "vite-node --config vitest.config.ts scripts/streamer-bilan.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ecrans": "vitest run --config vitest.ecrans.config.mts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:apk": "npm run android:sync && node scripts/android-gradle.mjs assembleRelease",
    "assets:regen": "node scripts/regen-avatars.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "catalog:source": "node scripts/build-twitch-catalog.mjs",
    "catalog:ci": "node scripts/build-catalog.mjs --check --strict-avatars && node scripts/build-supabase-catalogue.mjs --check && node scripts/build-supabase-seasons.mjs --check",
    "supabase:catalogue": "node scripts/build-supabase-catalogue.mjs",
    "supabase:saisons": "node scripts/build-supabase-seasons.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "essai:start": "node scripts/push-essai.mjs --start",
    "essai:push": "node scripts/push-essai.mjs",
    "supabase:verify": "node scripts/verify-supabase-migrations.mjs",
    "progression:bilan": "vite-node --config vitest.config.ts scripts/progression-bilan.ts",
    "catalogue:growth": "vite-node --config vitest.config.ts scripts/catalogue-growth-simulation.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "serve": "^14.2.4",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
